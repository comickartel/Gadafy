    <span class="hashtag">
        #Coding #Physics #Music #WebDevelopment
    </span>
</div>

<div class="comments-link">
    View all 42 comments
</div>

<div class="comment-box">

    <input
        placeholder="Add a comment..."
    >

    <button onclick="addComment(this)">
        Post
    </button>

</div>

</article>

