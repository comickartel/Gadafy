<!-- =======================================================
     POST 1
======================================================= -->

<article class="post" data-search="george tiffany coding physics trumpet">

<header class="post-header">

    <div class="user">

        <div class="avatar">
            <img src="https://i.pravatar.cc/100?img=12">
        </div>

        <div>
            <span class="username">
                george_tiffany
                <span class="verified">●</span>
            </span>

            <span class="time"> · 2h</span>
