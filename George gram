<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InstaNova</title>

<style>
/* =========================================================
   RESET + VARIABLES
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --black: #000;
    --dark: #0a0a0a;
    --card: #111;
    --card2: #181818;
    --border: #292929;
    --white: #fff;
    --gray: #a8a8a8;
    --blue: #0095f6;
    --red: #ff3040;
}

body {
    background: var(--black);
    color: var(--white);
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
    min-height: 100vh;
}

button,
input,
textarea {
    font: inherit;
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
    width: 7px;
}

::-webkit-scrollbar-track {
    background: #000;
}

::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 20px;
}

/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 245px;
    border-right: 1px solid var(--border);
    background: rgba(0,0,0,.96);
    padding: 28px 12px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.logo {
    margin: 0 15px 38px;
    font-size: 27px;
    font-weight: 900;
    font-style: italic;

    background:
        linear-gradient(
            45deg,
            #ffdc80,
            #fcaf45,
            #f77737,
            #e1306c,
            #c13584,
            #833ab4
        );

    -webkit-background-clip: text;
    color: transparent;
}

.nav {
    list-style: none;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 17px;
    padding: 13px 15px;
    margin-bottom: 5px;
    border-radius: 12px;
    cursor: pointer;
    transition: .2s;
}

.nav-item:hover {
    background: #171717;
}

.nav-item.active {
    font-weight: 800;
}

.nav-icon {
    width: 27px;
    font-size: 23px;
    text-align: center;
}

.sidebar-profile {
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 12px;
    border-radius: 12px;
    cursor: pointer;
}

.sidebar-profile:hover {
    background: #171717;
}

.sidebar-profile img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
}

/* =========================================================
   MAIN
========================================================= */

.main {
    margin-left: 245px;
    display: flex;
    justify-content: center;
    min-height: 100vh;
}

.feed {
    width: 630px;
    padding: 25px 15px 100px;
}

/* =========================================================
   TOP MOBILE BAR
========================================================= */

.mobile-top {
    display: none;
}

/* =========================================================
   STORIES
========================================================= */

.stories {
    display: flex;
    gap: 17px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 10px 5px 25px;
}

.stories::-webkit-scrollbar {
    display: none;
}

.story {
    min-width: 70px;
    text-align: center;
    cursor: pointer;
}

.story-ring {
    width: 67px;
    height: 67px;
    padding: 3px;
    margin: auto auto 7px;
    border-radius: 50%;

    background:
        linear-gradient(
            45deg,
            #feda75,
            #fa7e1e,
            #d62976,
            #962fbf,
            #4f5bd5
        );
}

.story-ring.seen {
    background: #444;
}

.story-avatar {
    width: 100%;
    height: 100%;
    border: 3px solid black;
    border-radius: 50%;
    overflow: hidden;
}

.story-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.story-name {
    color: #ddd;
    font-size: 12px;
}

/* =========================================================
   POST
========================================================= */

.post {
    border-bottom: 1px solid var(--border);
    padding-bottom: 25px;
    margin-bottom: 28px;
}

.post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 9px;
}

.user {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
}

.avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.username {
    font-size: 14px;
    font-weight: 750;
}

.verified {
    color: #3897f0;
}

.time {
    color: var(--gray);
    font-size: 13px;
}

.more {
    font-size: 20px;
    letter-spacing: 3px;
    cursor: pointer;
}

/* =========================================================
   POST MEDIA
========================================================= */

.post-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 5px;
    position: relative;
    background: #111;
    cursor: pointer;
}

.post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.art {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
}

.art-1 {
    background:
        radial-gradient(
            circle at 25% 25%,
            #ff006e,
            transparent 25%
        ),
        radial-gradient(
            circle at 75% 75%,
            #8338ec,
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #090909,
            #27114d
        );
}

.art-2 {
    background:
        radial-gradient(
            circle at 70% 30%,
            #00f5d4,
            transparent 25%
        ),
        radial-gradient(
            circle at 20% 80%,
            #00bbf9,
            transparent 30%
        ),
        #001219;
}

.art-3 {
    background:
        radial-gradient(
            circle,
            #ffbe0b,
            transparent 22%
        ),
        linear-gradient(
            135deg,
            #370617,
            #6a040f
        );
}

.art-icon {
    font-size: 90px;
    filter: drop-shadow(0 20px 20px rgba(0,0,0,.5));
}

.art h2 {
    margin-top: 15px;
    font-size: 25px;
}

.art p {
    margin-top: 5px;
    color: #ddd;
}

/* =========================================================
   HEART ANIMATION
========================================================= */

.big-heart {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 100px;
    transform: translate(-50%,-50%) scale(0);
    opacity: 0;
    pointer-events: none;
}

.big-heart.animate {
    animation: heart .8s ease;
}

@keyframes heart {

    0% {
        transform: translate(-50%,-50%) scale(0);
        opacity: 0;
    }

    30% {
        transform: translate(-50%,-50%) scale(1.3);
        opacity: 1;
    }

    70% {
        transform: translate(-50%,-50%) scale(1);
        opacity: 1;
    }

    100% {
        transform: translate(-50%,-50%) scale(.8);
        opacity: 0;
    }
}

/* =========================================================
   ACTIONS
========================================================= */

.actions {
    display: flex;
    justify-content: space-between;
    padding: 11px 2px 7px;
}

.action-group {
    display: flex;
    gap: 18px;
}

.action {
    font-size: 26px;
    cursor: pointer;
    transition: transform .15s;
    user-select: none;
}

.action:hover {
    transform: scale(1.13);
}

.action.liked {
    color: var(--red);
}

.action.saved {
    color: white;
}

/* =========================================================
   POST TEXT
========================================================= */

.likes {
    font-size: 14px;
    font-weight: 750;
    margin: 4px 0 7px;
}

.caption {
    font-size: 14px;
    line-height: 20px;
}

.caption strong {
    margin-right: 5px;
}

.hashtag {
    color: #4f8cff;
}

.comments-link {
    color: var(--gray);
    margin-top: 7px;
    font-size: 14px;
    cursor: pointer;
}

.comment-box {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid #222;
    padding: 10px 0 8px;
}

.comment-box input {
    flex: 1;
    background: none;
    color: white;
    border: none;
    outline: none;
}

.comment-box button {
    border: none;
    background: none;
    color: var(--blue);
    font-weight: bold;
    cursor: pointer;
}

/* =========================================================
   RIGHT SIDEBAR
========================================================= */

.right {
    position: fixed;
    left: calc(50% + 330px);
    top: 45px;
    width: 300px;
}

.account {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
}

.account-user {
    display: flex;
    align-items: center;
    gap: 12px;
}

.account-user img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
}

.account-user small {
    display: block;
    color: var(--gray);
}

.follow-btn {
    border: none;
    background: none;
    color: var(--blue);
    font-weight: bold;
    cursor: pointer;
}

.suggestion-heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
}

.suggestion-heading span:first-child {
    color: var(--gray);
    font-weight: bold;
}

.suggestion {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 17px;
}

.suggestion-user {
    display: flex;
    gap: 10px;
    align-items: center;
}

.suggestion img {
    width: 35px;
    height: 35px;
    border-radius: 50%;
}

.suggestion small {
    display: block;
    color: #777;
    margin-top: 2px;
}

/* =========================================================
   SEARCH PANEL
========================================================= */

.search-panel {
    position: fixed;
    left: 245px;
    top: 0;
    width: 400px;
    height: 100vh;
    background: #111;
    border-right: 1px solid #333;
    z-index: 1500;
    padding: 30px;
    transform: translateX(-110%);
    transition: .3s;
}

.search-panel.open {
    transform: translateX(0);
}

.search-panel h2 {
    margin-bottom: 25px;
}

.search-input {
    width: 100%;
    background: #222;
    border: none;
    outline: none;
    color: white;
    padding: 13px 15px;
    border-radius: 10px;
}

.search-results {
    margin-top: 25px;
}

.result {
    padding: 12px;
    border-radius: 10px;
    cursor: pointer;
}

.result:hover {
    background: #222;
}

/* =========================================================
   MODALS
========================================================= */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    backdrop-filter: blur(8px);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
}

.modal.open {
    display: flex;
}

.modal-card {
    width: min(500px, 92vw);
    background: #171717;
    border: 1px solid #333;
    border-radius: 18px;
    overflow: hidden;
}

.modal-title {
    text-align: center;
    font-weight: bold;
    padding: 17px;
    border-bottom: 1px solid #333;
}

.modal-body {
    padding: 20px;
}

.close {
    float: right;
    cursor: pointer;
    font-size: 22px;
}

/* =========================================================
   CREATE POST
========================================================= */

.create-text {
    width: 100%;
    min-height: 120px;
    resize: none;
    background: #222;
    color: white;
    border: none;
    outline: none;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 15px;
}

.file-label {
    display: block;
    padding: 15px;
    text-align: center;
    border: 1px dashed #555;
    border-radius: 10px;
    cursor: pointer;
    margin-bottom: 15px;
}

#createImage {
    display: none;
}

.primary-btn {
    width: 100%;
    border: none;
    background: var(--blue);
    color: white;
    padding: 13px;
    border-radius: 10px;
    font-weight: bold;
    cursor: pointer;
}

.primary-btn:hover {
    background: #0085df;
}

/* =========================================================
   STORY MODAL
========================================================= */

.story-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.95);
    z-index: 5000;
    display: none;
    align-items: center;
    justify-content: center;
}

.story-modal.open {
    display: flex;
}

.story-view {
    width: min(430px, 92vw);
    height: min(750px, 90vh);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    background: #222;
}

.story-view img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.story-close {
    position: absolute;
    top: 18px;
    right: 20px;
    font-size: 30px;
    cursor: pointer;
    z-index: 2;
}

.story-bar {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    height: 3px;
    background: rgba(255,255,255,.4);
}

.story-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: white;
    animation: storyTimer 5s linear forwards;
}

@keyframes storyTimer {
    to {
        width: 100%;
    }
}

/* =========================================================
   NOTIFICATIONS
========================================================= */

.notifications {
    position: fixed;
    right: 25px;
    top: 25px;
    width: 330px;
    background: #181818;
    border: 1px solid #333;
    border-radius: 15px;
    padding: 18px;
    z-index: 2500;
    display: none;
    box-shadow: 0 20px 70px rgba(0,0,0,.7);
}

.notifications.open {
    display: block;
}

.notification {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 0;
}

.notification img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
}

/* =========================================================
   TOAST
========================================================= */

.toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translate(-50%,120px);
    background: white;
    color: black;
    padding: 12px 22px;
    border-radius: 30px;
    font-weight: bold;
    z-index: 9000;
    transition: .3s;
}

.toast.show {
    transform: translate(-50%,0);
}

/* =========================================================
   MOBILE
========================================================= */

.mobile-nav {
    display: none;
}

@media(max-width:1100px) {

    .right {
        display: none;
    }

    .feed {
        width: 630px;
    }
}

@media(max-width:700px) {

    .sidebar {
        display: none;
    }

    .main {
        margin-left: 0;
    }

    .feed {
        width: 100%;
        padding: 0 0 70px;
    }

    .mobile-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 55px;
        padding: 0 16px;
        position: sticky;
        top: 0;
        background: rgba(0,0,0,.92);
        backdrop-filter: blur(15px);
        z-index: 900;
        border-bottom: 1px solid #222;
    }

    .mobile-logo {
        font-size: 23px;
        font-weight: 900;
        font-style: italic;
    }

    .post-media {
        border-radius: 0;
    }

    .post-header,
    .actions,
    .likes,
    .caption,
    .comments-link,
    .comment-box {
        margin-left: 12px;
        margin-right: 12px;
    }

    .mobile-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-around;
        background: rgba(0,0,0,.96);
        border-top: 1px solid #222;
        z-index: 2000;
    }

    .mobile-nav span {
        font-size: 24px;
        cursor: pointer;
    }

    .search-panel {
        left: 0;
        width: 100%;
    }
}
</style>
</head>

