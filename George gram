<!-- =======================================================
     TOAST
======================================================= -->

<div class="toast" id="toast"></div>

<script>

/* =========================================================
   LOCAL STORAGE
========================================================= */

const savedState =
    JSON.parse(localStorage.getItem("instanovaState")) || {
        liked: [],
        saved: [],
        following: []
    };


function saveState() {

    localStorage.setItem(
        "instanovaState",
        JSON.stringify(savedState)
    );

}


/* =========================================================
   TOAST
========================================================= */

let toastTimeout;

function showToast(message) {

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimeout);

    toastTimeout = setTimeout(() => {

        toast.classList.remove("show");

    }, 1800);

}


/* =========================================================
   LIKE
========================================================= */

function likePost(button) {

    const post =
        button.closest(".post");

    const number =
        post.querySelector(".like-count");

    let count =
        parseInt(number.textContent);

    if (button.classList.contains("liked")) {

        button.classList.remove("liked");

        button.textContent = "♡";

        count--;

    } else {

        button.classList.add("liked");

        button.textContent = "♥";

        count++;

    }

    number.textContent =
        count.toLocaleString();

    saveState();

}


/* =========================================================
   DOUBLE CLICK LIKE
========================================================= */

function doubleLike(media) {

    const post =
        media.closest(".post");

    const button =
        post.querySelector(".like");

    if (!button.classList.contains("liked")) {

        likePost(button);

    }

    const heart =
        media.querySelector(".big-heart");

    heart.classList.remove("animate");

    void heart.offsetWidth;

    heart.classList.add("animate");

}


/* =========================================================
   SAVE
========================================================= */

function savePost(button) {

    button.classList.toggle("saved");

    if (button.classList.contains("saved")) {

        button.textContent = "▣";

        showToast("Post saved");

    } else {

        button.textContent = "▢";

        showToast("Post removed from saved");

    }

    saveState();

}


/* =========================================================
   COMMENT
========================================================= */

function focusComment(button) {

    const post =
        button.closest(".post");

    const input =
        post.querySelector("input");

    input.focus();

}


function addComment(button) {

    const box =
        button.closest(".comment-box");

    const input =
        box.querySelector("input");

    const text =
        input.value.trim();

    if (!text) {

        showToast("Write a comment first");

        return;

    }

    const post =
        button.closest(".post");

    const comments =
        post.querySelector(".comments-link");

    comments.textContent =
        "Your comment: " + text;

    input.value = "";

    showToast("Comment posted 💬");

}


/* =========================================================
   FOLLOW
========================================================= */

function followUser(button) {

    if (button.textContent === "Follow") {

        button.textContent = "Following";

        button.style.color = "#aaa";

        showToast("Following");

    } else {

        button.textContent = "Follow";

        button.style.color = "#0095f6";

        showToast("Unfollowed");

    }

}


/* =========================================================
   SEARCH
========================================================= */

function openSearch() {

    document
        .getElementById("searchPanel")
        .classList.add("open");

    setTimeout(() => {

        document
            .getElementById("searchInput")
            .focus();

    }, 200);

}


const searchInput =
    document.getElementById("searchInput");

searchInput.addEventListener(
    "input",
    searchPosts
);


function searchPosts() {

    const query =
        searchInput.value
            .toLowerCase()
            .trim();

    const posts =
        document.querySelectorAll(".post");

    posts.forEach(post => {

        const text =
            post.dataset.search.toLowerCase();

        post.style.display =
            text.includes(query)
                ? ""
                : "none";

    });

}


/* =========================================================
   HOME
========================================================= */

function goHome() {

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}


/* =========================================================
   CREATE POST
========================================================= */

function openCreate() {

    document
        .getElementById("createModal")
        .classList.add("open");

}


function previewImage(event) {

    const file =
        event.target.files[0];

    if (!file) return;

    const preview =
        document.getElementById("preview");

    preview.src =
        URL.createObjectURL(file);

    preview.style.display =
        "block";

}


function createPost() {

    const text =
        document
            .getElementById("postText")
            .value
            .trim();

    const file =
        document
            .getElementById("createImage")
            .files[0];

    if (!text && !file) {

        showToast("Add a caption or image");

        return;

    }

    const post =
        document.createElement("article");

    post.className = "post";

    post.dataset.search =
        text.toLowerCase();

    let media = "";

    if (file) {

        const imageURL =
            URL.createObjectURL(file);

        media = `
            <div
                class="post-media"
                ondblclick="doubleLike(this)"
            >
                <img src="${imageURL}">
                <div class="big-heart">❤️</div>
            </div>
        `;

    } else {

        media = `
            <div
                class="post-media"
                ondblclick="doubleLike(this)"
            >
                <div
                    class="art"
                    style="
                        background:
                        linear-gradient(
                            135deg,
                            #8338ec,
                            #ff006e
                        );
                    "
                >
                    <div class="art-icon">✨</div>
                    <h2>New Post</h2>
                </div>

                <div class="big-heart">❤️</div>
            </div>
        `;

    }

    post.innerHTML = `

        <header class="post-header">

            <div class="user">

                <div class="avatar">
                    <img src="https://i.pravatar.cc/100?img=12">
                </div>

                <div>

                    <span class="username">
                        george_tiffany
                        <span class="verified">●</span>
                    </span>

                    <span class="time"> · now</span>

                </div>

            </div>

            <div class="more">•••</div>

        </header>

        ${media}

        <div class="actions">

            <div class="action-group">

                <span
                    class="action like"
                    onclick="likePost(this)"
                >♡</span>

                <span
                    class="action"
                    onclick="focusComment(this)"
                >○</span>

                <span
                    class="action"
                    onclick="sharePost()"
                >➤</span>

            </div>

            <span
                class="action"
                onclick="savePost(this)"
            >▢</span>

        </div>

        <div class="likes">

            <span class="like-count">
                0
            </span>

            likes

        </div>

        <div class="caption">

            <strong>
                george_tiffany
            </strong>

            ${escapeHTML(text)}

        </div>

        <div class="comments-link">
            Be the first to comment
        </div>

        <div class="comment-box">

            <input
                placeholder="Add a comment..."
            >

            <button
                onclick="addComment(this)"
            >
                Post
            </button>

        </div>

    `;

    document
        .querySelector(".feed")
        .appendChild(post);

    document
        .getElementById("postText")
        .value = "";

    document
        .getElementById("createImage")
        .value = "";

    document
        .getElementById("preview")
        .style.display = "none";

    closeModal("createModal");

    showToast("Your post is live! 🚀");

}


function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


/* =========================================================
   SHARE
========================================================= */

function sharePost() {

    if (
        navigator.share
    ) {

        navigator.share({
            title: "InstaNova post",
            text: "Check out this post!"
        });

    } else {

        showToast("Post link copied!");

    }

}


/* =========================================================
   STORIES
========================================================= */

const stories = [

    "https://i.pravatar.cc/800?img=12",
    "https://i.pravatar.cc/800?img=32",
    "https://i.pravatar.cc/800?img=44",
    "https://i.pravatar.cc/800?img=49",
    "https://i.pravatar.cc/800?img=58",
    "https://i.pravatar.cc/800?img=68"

];


function openStory(index) {

    document
        .getElementById("storyImage")
        .src = stories[index];

    document
        .getElementById("storyModal")
        .classList.add("open");

}


function closeStory() {

    document
        .getElementById("storyModal")
        .classList.remove("open");

}


/* =========================================================
   PROFILE
========================================================= */

function openProfile() {

    document
        .getElementById("profileModal")
        .classList.add("open");

}


/* =========================================================
   MODAL CLOSE
========================================================= */

function closeModal(id) {

    document
        .getElementById(id)
        .classList.remove("open");

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

function toggleNotifications() {

    document
        .getElementById("notifications")
        .classList.toggle("open");

}


/* =========================================================
   SWITCH ACCOUNT
========================================================= */

function switchAccount() {

    showToast("Account switcher opened");

}


/* =========================================================
   CLICK OUTSIDE MODALS
========================================================= */

document.addEventListener(
    "click",
    event => {

        const search =
            document.getElementById("searchPanel");

        if (
            search.classList.contains("open") &&
            !search.contains(event.target) &&
            !event.target.closest(".nav-item")
        ) {

            search.classList.remove("open");

        }

    }
);


/* =========================================================
   ESCAPE
========================================================= */

document.addEventListener(
    "keydown",
    event => {

        if (event.key === "Escape") {

            document
                .querySelectorAll(
                    ".modal.open, .story-modal.open"
                )
                .forEach(el =>
                    el.classList.remove("open")
                );

            document
                .getElementById("searchPanel")
                .classList.remove("open");

            document
                .getElementById("notifications")
                .classList.remove("open");

        }

    }
);

</script>

