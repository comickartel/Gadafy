<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YouTube Clone</title>

<style>
/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#0f0f0f;
    color:#fff;
    font-family:Roboto,Arial,Helvetica,sans-serif;
}

/* =========================================================
   HEADER
========================================================= */

.header{
    height:64px;
    position:fixed;
    top:0;
    left:0;
    right:0;
    background:#0f0f0f;
    display:flex;
    align-items:center;
    padding:0 20px;
    z-index:1000;
    border-bottom:1px solid #222;
}

.menu-btn{
    width:40px;
    height:40px;
    border:0;
    background:none;
    color:white;
    font-size:25px;
    cursor:pointer;
    border-radius:50%;
}

.menu-btn:hover{
    background:#272727;
}

.logo{
    display:flex;
    align-items:center;
    gap:5px;
    margin-left:12px;
    font-size:22px;
    font-weight:900;
    cursor:pointer;
}

.youtube-icon{
    width:34px;
    height:24px;
    border-radius:7px;
    background:#ff0000;
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    font-size:13px;
}

.search-container{
    flex:1;
    max-width:650px;
    display:flex;
    margin:auto;
}

.search-input{
    flex:1;
    height:42px;
    background:#121212;
    color:#fff;
    border:1px solid #303030;
    border-radius:22px 0 0 22px;
    padding:0 18px;
    outline:none;
    font-size:16px;
}

.search-input:focus{
    border-color:#3ea6ff;
}

.search-button{
    width:65px;
    height:42px;
    background:#272727;
    border:1px solid #303030;
    color:white;
    border-radius:0 22px 22px 0;
    cursor:pointer;
    font-size:20px;
}

.search-button:hover{
    background:#333;
}

.header-actions{
    display:flex;
    align-items:center;
    gap:8px;
}

.header-btn{
    border:0;
    background:none;
    color:#fff;
    font-size:22px;
    width:42px;
    height:42px;
    border-radius:50%;
    cursor:pointer;
}

.header-btn:hover{
    background:#272727;
}

.profile{
    width:34px;
    height:34px;
    border-radius:50%;
    background:linear-gradient(135deg,#ff416c,#ff4b2b);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
    cursor:pointer;
}

/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{
    position:fixed;
    top:64px;
    left:0;
    bottom:0;
    width:240px;
    background:#0f0f0f;
    padding:12px;
    overflow-y:auto;
    z-index:900;
}

.sidebar-section{
    padding-bottom:12px;
    margin-bottom:12px;
    border-bottom:1px solid #303030;
}

.sidebar-item{
    height:44px;
    display:flex;
    align-items:center;
    gap:24px;
    padding:0 15px;
    border-radius:10px;
    cursor:pointer;
    font-size:14px;
}

.sidebar-item:hover{
    background:#272727;
}

.sidebar-item.active{
    background:#272727;
    font-weight:bold;
}

.sidebar-icon{
    width:24px;
    text-align:center;
    font-size:21px;
}

.sidebar-title{
    padding:12px 15px;
    color:#aaa;
    font-size:14px;
    font-weight:bold;
}

/* =========================================================
   MAIN
========================================================= */

.main{
    margin-left:240px;
    padding:84px 24px 50px;
}

/* =========================================================
   CATEGORY BAR
========================================================= */

.categories{
    position:fixed;
    top:64px;
    left:240px;
    right:0;
    height:56px;
    background:#0f0f0f;
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 20px;
    overflow-x:auto;
    z-index:800;
    scrollbar-width:none;
}

.categories::-webkit-scrollbar{
    display:none;
}

.category{
    white-space:nowrap;
    background:#272727;
    color:white;
    border:0;
    padding:9px 15px;
    border-radius:9px;
    cursor:pointer;
    font-size:14px;
}

.category:hover{
    background:#3f3f3f;
}

.category.active{
    background:white;
    color:black;
}

/* =========================================================
   VIDEO GRID
========================================================= */

.video-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:38px 16px;
}

.video-card{
    min-width:0;
    cursor:pointer;
}

.thumbnail{
    width:100%;
    aspect-ratio:16/9;
    border-radius:10px;
    overflow:hidden;
    position:relative;
    background:#222;
}

.thumbnail img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.25s;
}

.video-card:hover .thumbnail img{
    transform:scale(1.04);
}

.duration{
    position:absolute;
    right:6px;
    bottom:6px;
    background:rgba(0,0,0,.85);
    padding:3px 5px;
    border-radius:3px;
    font-size:12px;
}

.video-info{
    display:flex;
    gap:12px;
    padding-top:11px;
}

.channel-avatar{
    flex:0 0 38px;
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,#673ab7,#e91e63);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

.video-details{
    min-width:0;
}

.video-title{
    font-size:15px;
    font-weight:600;
    line-height:21px;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
}

.channel-name{
    color:#aaa;
    font-size:13px;
    margin-top:7px;
}

.channel-name .verified{
    color:#aaa;
}

.video-meta{
    color:#aaa;
    font-size:13px;
    margin-top:4px;
}

/* =========================================================
   LIVE CARD
========================================================= */

.live{
    position:absolute;
    left:7px;
    bottom:7px;
    background:#ff0000;
    padding:4px 7px;
    border-radius:3px;
    font-size:11px;
    font-weight:bold;
}

/* =========================================================
   PLAYER MODAL
========================================================= */

.player-modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.96);
    z-index:5000;
    display:none;
    overflow-y:auto;
}

.player-modal.open{
    display:block;
}

.player-container{
    width:min(1100px,94%);
    margin:70px auto;
}

.close-player{
    position:fixed;
    top:18px;
    right:25px;
    width:45px;
    height:45px;
    border:0;
    border-radius:50%;
    background:#272727;
    color:white;
    font-size:25px;
    cursor:pointer;
    z-index:10;
}

.video-player{
    width:100%;
    aspect-ratio:16/9;
    background:#000;
    border-radius:8px;
    overflow:hidden;
}

.video-player img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.player-title{
    font-size:22px;
    margin-top:18px;
}

.player-channel{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:18px;
    padding-bottom:18px;
    border-bottom:1px solid #303030;
}

.channel-info{
    display:flex;
    align-items:center;
    gap:12px;
}

.subscribe{
    background:#fff;
    color:#000;
    border:0;
    padding:10px 18px;
    border-radius:20px;
    font-weight:bold;
    cursor:pointer;
}

.subscribe.subscribed{
    background:#272727;
    color:#fff;
}

.player-actions{
    display:flex;
    gap:10px;
}

.player-action{
    border:0;
    background:#272727;
    color:white;
    padding:10px 15px;
    border-radius:20px;
    cursor:pointer;
}

.player-action:hover{
    background:#3f3f3f;
}

.description{
    background:#272727;
    border-radius:12px;
    padding:15px;
    margin-top:18px;
    line-height:22px;
    font-size:14px;
}

/* =========================================================
   COMMENTS
========================================================= */

.comments{
    margin-top:30px;
}

.comments h2{
    font-size:20px;
    margin-bottom:20px;
}

.comment-input{
    display:flex;
    gap:12px;
    margin-bottom:25px;
}

.comment-input input{
    flex:1;
    background:transparent;
    border:0;
    border-bottom:1px solid #555;
    color:#fff;
    padding:10px;
    outline:none;
}

.comment-input button{
    background:#3ea6ff;
    color:#000;
    border:0;
    padding:9px 15px;
    border-radius:18px;
    font-weight:bold;
    cursor:pointer;
}

.comment{
    display:flex;
    gap:12px;
    margin-bottom:20px;
}

.comment-avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,#00c6ff,#0072ff);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
    flex-shrink:0;
}

.comment-author{
    font-weight:bold;
    font-size:13px;
}

.comment-text{
    margin-top:5px;
    line-height:20px;
}

/* =========================================================
   CREATE PANEL
========================================================= */

.create-panel{
    position:fixed;
    top:75px;
    right:25px;
    width:350px;
    background:#282828;
    border-radius:15px;
    padding:20px;
    z-index:4000;
    display:none;
    box-shadow:0 10px 50px #000;
}

.create-panel.open{
    display:block;
}

.create-panel h2{
    margin-bottom:20px;
}

.create-panel input,
.create-panel textarea{
    width:100%;
    background:#181818;
    color:#fff;
    border:1px solid #444;
    border-radius:8px;
    padding:12px;
    margin-bottom:12px;
    outline:none;
}

.create-panel textarea{
    resize:none;
    height:100px;
}

.create-button{
    width:100%;
    background:#ff0000;
    color:white;
    border:0;
    padding:12px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

/* =========================================================
   NOTIFICATIONS
========================================================= */

.notification-panel{
    position:fixed;
    top:65px;
    right:80px;
    width:350px;
    max-height:500px;
    overflow:auto;
    background:#282828;
    border-radius:12px;
    padding:15px;
    z-index:4000;
    display:none;
    box-shadow:0 10px 50px #000;
}

.notification-panel.open{
    display:block;
}

.notification{
    display:flex;
    gap:12px;
    padding:15px 5px;
    border-bottom:1px solid #3a3a3a;
}

.notification-icon{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#ff0000;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;
    bottom:30px;
    left:50%;
    transform:translate(-50%,120px);
    background:#fff;
    color:#000;
    padding:13px 22px;
    border-radius:30px;
    font-weight:bold;
    z-index:9000;
    transition:.3s;
}

.toast.show{
    transform:translate(-50%,0);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1200px){

    .video-grid{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:900px){

    .sidebar{
        width:72px;
    }

    .sidebar-item{
        justify-content:center;
        padding:0;
    }

    .sidebar-item span:last-child,
    .sidebar-title{
        display:none;
    }

    .main{
        margin-left:72px;
    }

    .categories{
        left:72px;
    }

    .video-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:600px){

    .header{
        padding:0 10px;
    }

    .logo span{
        display:none;
    }

    .search-container{
        margin-left:10px;
    }

    .header-actions .header-btn:first-child{
        display:none;
    }

    .sidebar{
        display:none;
    }

    .main{
        margin-left:0;
        padding:125px 10px 70px;
    }

    .categories{
        left:0;
        top:64px;
    }

    .video-grid{
        grid-template-columns:1fr;
        gap:25px;
    }

    .thumbnail{
        border-radius:6px;
    }

    .player-container{
        width:100%;
        margin:64px auto 20px;
    }

    .player-title{
        padding:0 12px;
        font-size:18px;
    }

    .player-channel,
    .description,
    .comments{
        margin-left:12px;
        margin-right:12px;
    }

    .notification-panel,
    .create-panel{
        right:10px;
        width:calc(100% - 20px);
    }

}

/* =========================================================
   EMPTY SEARCH
========================================================= */

.no-results{
    grid-column:1/-1;
    text-align:center;
    padding:80px 20px;
    color:#aaa;
    font-size:18px;
}

</style>
</head>

