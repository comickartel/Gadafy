<!-- =========================================================
     TOAST
========================================================= -->

<div
    class="toast"
    id="toast"
></div>


<script>

/* =========================================================
   GLOBAL STATE
========================================================= */

let currentVideo = null;
let subscribed = false;
let liked = false;


/* =========================================================
   TOAST
========================================================= */

let toastTimer;

function showToast(message){

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {

        toast.classList.remove("show");

    },2000);
}


/* =========================================================
   HOME
========================================================= */

function goHome(){

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

    document
        .querySelectorAll(".video-card")
        .forEach(card => {
            card.style.display = "";
        });

}


/* =========================================================
   SIDEBAR
========================================================= */

function toggleSidebar(){

    const sidebar =
        document.getElementById("sidebar");

    if(window.innerWidth <= 900){

        sidebar.style.display =
            sidebar.style.display === "none"
                ? "block"
                : "none";

    }

}


/* =========================================================
   SEARCH
========================================================= */

function searchKey(event){

    if(event.key === "Enter"){

        searchVideos();

    }

}


function searchVideos(){

    const query =
        document
            .getElementById("searchInput")
            .value
            .trim()
            .toLowerCase();

    const cards =
        document.querySelectorAll(".video-card");

    let found = 0;

    cards.forEach(card => {

        const title =
            card
                .dataset
                .title
                .toLowerCase();

        const category =
            card
                .dataset
                .category
                .toLowerCase();

        if(
            !query ||
            title.includes(query) ||
            category.includes(query)
        ){

            card.style.display = "";

            found++;

        }else{

            card.style.display = "none";

        }

    });

    if(query){

        showToast(
            found +
            " result" +
            (found === 1 ? "" : "s") +
            " found"
        );

    }

}


/* =========================================================
   CATEGORY FILTER
========================================================= */

function filterCategory(category,button){

    document
        .querySelectorAll(".category")
        .forEach(item => {

            item.classList.remove("active");

        });

    button.classList.add("active");

    document
        .querySelectorAll(".video-card")
        .forEach(card => {

            if(
                category === "all" ||
                card.dataset.category
                    .includes(category)
            ){

                card.style.display = "";

            }else{

                card.style.display = "none";

            }

        });

}


/* =========================================================
   OPEN VIDEO
========================================================= */

function openVideo(card){

    currentVideo = card;

    const image =
        card.querySelector(".thumbnail img");

    const title =
        card.dataset.title;

    document
        .getElementById("playerImage")
        .src = image.src;

    document
        .getElementById("playerTitle")
        .textContent = title;

    document
        .getElementById("playerModal")
        .classList.add("open");

    document.body.style.overflow = "hidden";

}


/* =========================================================
   CLOSE PLAYER
========================================================= */

function closePlayer(){

    document
        .getElementById("playerModal")
        .classList.remove("open");

    document.body.style.overflow = "";

}


/* =========================================================
   SUBSCRIBE
========================================================= */

function subscribe(){

    const button =
        document
            .getElementById("subscribeButton");

    subscribed = !subscribed;

    if(subscribed){

        button.textContent =
            "Subscribed ✓";

        button.classList.add("subscribed");

        showToast("Subscribed!");

    }else{

        button.textContent =
            "Subscribe";

        button.classList.remove("subscribed");

        showToast("Unsubscribed");

    }

}


/* =========================================================
   LIKE VIDEO
========================================================= */

function likeVideo(){

    const button =
        document.getElementById("likeButton");

    liked = !liked;

    if(liked){

        button.textContent =
            "👍 Liked";

        showToast("Video liked!");

    }else{

        button.textContent =
            "👍 Like";

        showToast("Like removed");

    }

}


/* =========================================================
   SHARE
========================================================= */

function shareVideo(){

    if(navigator.share){

        navigator.share({
            title:
                document.getElementById(
                    "playerTitle"
                ).textContent,

            text:
                "Check out this video!"
        });

    }else{

        showToast("Video link copied!");

    }

}


/* =========================================================
   SAVE
========================================================= */

function saveVideo(){

    showToast("Saved to Watch later");

}


/* =========================================================
   COMMENTS
========================================================= */

function commentKey(event){

    if(event.key === "Enter"){

        addComment();

    }

}


function addComment(){

    const input =
        document.getElementById(
            "commentInput"
        );

    const text =
        input.value.trim();

    if(!text){

        showToast(
            "Write a comment first"
        );

        return;

    }

    const comment =
        document.createElement("div");

    comment.className = "comment";

    comment.innerHTML = `

        <div class="comment-avatar">
            G
        </div>

        <div>

            <div class="comment-author">
                You
            </div>

            <div class="comment-text">
                ${escapeHTML(text)}
            </div>

        </div>

    `;

    document
        .getElementById("commentList")
        .prepend(comment);

    input.value = "";

    showToast("Comment added!");

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(text){

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


/* =========================================================
   CREATE
========================================================= */

function openCreate(){

    document
        .getElementById("createPanel")
        .classList.toggle("open");

    document
        .getElementById("notificationPanel")
        .classList.remove("open");

}


function createVideo(){

    const title =
        document
            .getElementById("newTitle")
            .value
            .trim();

    const description =
        document
            .getElementById("newDescription")
            .value
            .trim();

    if(!title){

        showToast(
            "Enter a video title"
        );

        return;

    }

    const grid =
        document.getElementById("videoGrid");

    const card =
        document.createElement("article");

    card.className =
        "video-card";

    card.dataset.title =
        title;

    card.dataset.category =
        "all";

    card.onclick =
        function(){

            openVideo(card);

        };

    const imageURL =
        "https://picsum.photos/seed/" +
        Date.now() +
        "/800/450";

    card.innerHTML = `

        <div class="thumbnail">

            <img src="${imageURL}">

            <span class="duration">
                NEW
            </span>

        </div>

        <div class="video-info">

            <div class="channel-avatar">
                G
            </div>

            <div class="video-details">

                <div class="video-title">
                    ${escapeHTML(title)}
                </div>

                <div class="channel-name">
                    George Channel ✓
                </div>

                <div class="video-meta">
                    Just now · 0 views
                </div>

            </div>

        </div>

    `;

    grid.prepend(card);

    document
        .getElementById("newTitle")
        .value = "";

    document
        .getElementById("newDescription")
        .value = "";

    document
        .getElementById("createPanel")
        .classList.remove("open");

    showToast("Video published!");

}


/* =========================================================
   NOTIFICATIONS
========================================================= */

function toggleNotifications(){

    document
        .getElementById("notificationPanel")
        .classList.toggle("open");

    document
        .getElementById("createPanel")
        .classList.remove("open");

}


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closePlayer();

            document
                .getElementById("createPanel")
                .classList.remove("open");

            document
                .getElementById("notificationPanel")
                .classList.remove("open");

        }

    }
);


/* =========================================================
   CLOSE MODALS BY CLICKING OUTSIDE
========================================================= */

document
    .getElementById("playerModal")
    .addEventListener(
        "click",
        function(event){

            if(event.target === this){

                closePlayer();

            }

        }
    );

</script>

</body>
